<div class="page-header">
  <div>
    <h1>MLA Office &mdash; Master Dashboard</h1>
    <p class="muted">Full taluka overview &middot; Akole (190+ villages)</p>
  </div>
  <a href="/admin/export?<%= filterQueryString %>" class="btn btn-secondary">⬇ Export CSV</a>
</div>

<div class="kpi-row">
  <div class="kpi-box"><span class="kpi-num"><%= kpis.totalReceived %></span><span class="kpi-label">Total Received</span></div>
  <div class="kpi-box"><span class="kpi-num"><%= kpis.totalResolved %></span><span class="kpi-label">Total Resolved</span></div>
  <div class="kpi-box"><span class="kpi-num"><%= kpis.avgResolutionDays %></span><span class="kpi-label">Avg. Resolution (days)</span></div>
  <div class="kpi-box"><span class="kpi-num"><%= villageBreakdown.length %></span><span class="kpi-label">Villages With Complaints</span></div>
</div>

<div class="dashboard-columns">
  <div class="dashboard-main">
    <h2 class="section-title">Filter Complaints</h2>
    <form class="filter-bar" method="GET" action="/admin/dashboard">
      <select name="village">
        <option value="">All Villages</option>
        <% villages.forEach(function(v) { %>
          <option value="<%= v._id %>" <%= filters.village == v._id ? 'selected' : '' %>><%= v.villageName %></option>
        <% }); %>
      </select>

      <select name="department">
        <option value="">All Departments</option>
        <% ['Roads/Infrastructure','Water Supply','MSEB/Electricity','Health/Hospital','Agriculture/Irrigation','Revenue/Land','Personal Grievance','Education'].forEach(function(d) { %>
          <option value="<%= d %>" <%= filters.department === d ? 'selected' : '' %>><%= d %></option>
        <% }); %>
      </select>

      <select name="status">
        <option value="">All Statuses</option>
        <% ['Submitted','Under Review','Letter Issued','Resolved','Rejected'].forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>

      <select name="urgency">
        <option value="">All Urgency</option>
        <% ['Normal','High','Emergency'].forEach(function(u) { %>
          <option value="<%= u %>" <%= filters.urgency === u ? 'selected' : '' %>><%= u %></option>
        <% }); %>
      </select>

      <input type="date" name="from" value="<%= filters.from || '' %>">
      <input type="date" name="to" value="<%= filters.to || '' %>">
      <input type="text" name="q" placeholder="Search ticket / title" value="<%= filters.q || '' %>">

      <button type="submit" class="btn btn-primary">Apply Filters</button>
      <a href="/admin/dashboard" class="btn btn-ghost">Clear</a>
    </form>

    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Ticket</th>
            <th>Village</th>
            <th>Worker</th>
            <th>Category</th>
            <th>Urgency</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% complaints.forEach(function(c) { %>
            <tr onclick="window.location='/admin/complaints/<%= c._id %>'" class="clickable-row">
              <td><%= c.ticketNumber %></td>
              <td><%= c.village ? c.village.villageName : '—' %></td>
              <td><%= c.user ? c.user.fullName : '—' %></td>
              <td><%= c.category %></td>
              <td><span class="urgency urgency-<%= c.urgency.toLowerCase() %>"><%= c.urgency %></span></td>
              <td><span class="badge badge-<%= c.status.replace(/\s+/g,'-').toLowerCase() %>"><%= c.status %></span></td>
              <td><%= new Date(c.createdAt).toLocaleDateString('en-IN') %></td>
            </tr>
          <% }); %>
          <% if (complaints.length === 0) { %>
            <tr><td colspan="7" class="muted" style="text-align:center;padding:2rem;">No complaints match these filters.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="dashboard-side">
    <div class="detail-card">
      <h3>Grievance Volume by Village</h3>
      <ul class="bar-list">
        <% const maxCount = villageBreakdown.length ? villageBreakdown[0].count : 1; %>
        <% villageBreakdown.slice(0, 12).forEach(function(v) { %>
          <li>
            <div class="bar-list-label"><span><%= v.name %></span><span><%= v.count %></span></div>
            <div class="bar-track"><div class="bar-fill" style="width:<%= Math.round((v.count / maxCount) * 100) %>%"></div></div>
          </li>
        <% }); %>
        <% if (villageBreakdown.length === 0) { %><li class="muted">No data yet.</li><% } %>
      </ul>
    </div>

    <div class="detail-card">
      <h3>Department-wise Breakdown</h3>
      <ul class="bar-list">
        <% const maxDept = byDept.length ? Math.max(...byDept.map(d=>d.count)) : 1; %>
        <% byDept.forEach(function(d) { %>
          <li>
            <div class="bar-list-label"><span><%= d._id %></span><span><%= d.count %></span></div>
            <div class="bar-track"><div class="bar-fill bar-fill-alt" style="width:<%= Math.round((d.count / maxDept) * 100) %>%"></div></div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>
</div>
